# Bootstrap Admin (used on first run only)
# These are read by `python manage.py bootstrap_admin` and by AccountsConfig.ready().
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-run

# Django
SECRET_KEY=dev-secret-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (SQLite default; PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:pass@localhost:5432/blogdb

# Optional: skip automatic bootstrap (tests / CI)
# DJANGO_SKIP_BOOTSTRAP=true
