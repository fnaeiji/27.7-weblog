{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git remote -v": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git rebase*": "ask",
      "git checkout --*": "ask",
      "git switch*": "ask",
      "git branch -D*": "ask"
    }
  }
}
